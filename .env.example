# ==============================================================================
# AvtoFast Backend Environment Configuration
# Production Domain: api.avtotest.uz
# ==============================================================================

# Application Configuration
APP_NAME=avtofast-api
APP_ENV=production
PORT=8080
PREFORK=false
API_BASE_URL=https://api.avtotest.uz/v1

# PostgreSQL Configuration (Using BIGSERIAL primary keys)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=avtofast
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_CONNS=80
POSTGRES_MIN_CONNS=20
POSTGRES_MAX_CONN_LIFETIME=30m

# Redis Configuration (Cache, Idempotency, Rate Limiting)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=100

# Authentication & JWT
JWT_SECRET=avtofast-super-secure-production-secret-key-32b
JWT_ISSUER=https://api.avtotest.uz/auth
JWT_AUDIENCE=avtofast-api
# Session token lifetimes. Access tokens are short so a role change or a
# deleted account stops working quickly; refresh tokens are long so a learner
# who opens the app once a fortnight is not signed out.
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=2160h

# Firebase project whose ID tokens POST /v1/auth/session will accept.
# Leave empty to disable sign-in exchange entirely (guest sessions still work).
FIREBASE_PROJECT_ID=avtofast-8fba6

# Ed25519 Content Manifest Signing Keys (Base64)
# Leave empty to auto-generate a deterministic key pair
ED25519_PRIVATE_KEY=key
ED25519_PUBLIC_KEY=public_key

# Feature Flags (P1 & P2 features disabled by default for release)
FEATURE_FRIENDS=false
FEATURE_WEEKLY_CHALLENGES=false
FEATURE_VOICE_EXPLANATIONS=false
FEATURE_AI_MISTAKE_ANALYSIS=false

# Exam Rules
EXAM_QUESTION_COUNT=20
EXAM_DURATION_SEC=1200
EXAM_PASS_COUNT=16
